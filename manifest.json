{
  "manifest_version": 3,
  "name": "Yadokari",
  "version": "0.0.0",
  "description": "Arcの使い勝手をChromeに持ち込む個人用拡張機能。タブ・ブックマーク・履歴を曖昧検索するコマンドバーなど。",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "bookmarks",
    "favicon",
    "history",
    "scripting",
    "search",
    "sessions",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Yadokari",
    "default_popup": "src/bar.html?mode=popup"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+T"
      },
      "description": "コマンドバーを開く／閉じる"
    }
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/bar.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
